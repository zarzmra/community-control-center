DB_HOST=localhost
DB_PORT=5432
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=community_control_center

# Redis Configuration (Template - Replace with your values)
REDIS_URL=redis://REDIS_HOST:REDIS_PORT/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
